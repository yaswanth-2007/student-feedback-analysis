# Student Feedback Analysis System - Environment Configuration Example
FLASK_APP=run.py
FLASK_ENV=development
DEBUG=True
SECRET_KEY=replace-with-a-secure-random-value-minimum-32-chars

# Primary MySQL Database connection string:
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/student_feedback_db

# Local fallback SQLite database if MySQL is not available during local testing:
# DATABASE_URL=sqlite:///feedback_local.db

# Enable synthetic demonstration data indicator
SEED_DEMO_DATA=false
